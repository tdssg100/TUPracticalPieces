 <web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

 
 
    
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>TUPracticalPieces</web-resource-name>
      <url-pattern>/*</url-pattern>
    </web-resource-collection>
    <user-data-constraint>
      <transport-guarantee>NONE</transport-guarantee>
    </user-data-constraint>
  </security-constraint>
  
  <welcome-file-list>
    <welcome-file>TUPracticalPieces.html</welcome-file>
  </welcome-file-list>
  
  <servlet>
    <servlet-name>requestFactoryServlet</servlet-name>
    <servlet-class>com.google.web.bindery.requestfactory.server.RequestFactoryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>requestFactoryServlet</servlet-name>
    <url-pattern>/gwtRequest</url-pattern>
  </servlet-mapping>
  <filter>
    <filter-name>GaeAuthFilter</filter-name>
    <filter-class>com.google.gwt.personal.gaerequest.server.GaeAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>GaeAuthFilter</filter-name>
    <url-pattern>/gwtRequest/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>MileageDataUtils</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.database.MileageDataUtils</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>MileageDataUtils</servlet-name>
    <url-pattern>/mileagedatautils</url-pattern>
  </servlet-mapping>
  <filter>
    <filter-name>MileageUtilsFilter</filter-name>
    <filter-class>com.google.gwt.personal.gaerequest.server.MileageUtilsFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>MileageUtilsFilter</filter-name>
    <url-pattern>/mileagedatautils/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>AdminTaskImpl</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.server.AdminTaskImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminTaskImpl</servlet-name>
    <url-pattern>/tupracticalpieces/admintask</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>AdminSvcImpl</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.server.AdminSvcImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminSvcImpl</servlet-name>
    <url-pattern>/tupracticalpieces/adminsvc</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>OAuthCodeCallbackHandlerServlet</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.server.OAuthCodeCallbackHandlerServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>OAuthCodeCallbackHandlerServlet</servlet-name>
    <url-pattern>/oauth2callback</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>HotSpotListTransitServlet</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.server.HotSpotListTransitServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HotSpotListTransitServlet</servlet-name>
    <url-pattern>/proxy8181</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>NewsCountExcludeTransitServlet</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.server.NewsCountExcludeTransitServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>NewsCountExcludeTransitServlet</servlet-name>
    <url-pattern>/agent8181</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>SurveillanceCameraProxyServlet</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.server.SurveillanceCameraProxyServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SurveillanceCameraProxyServlet</servlet-name>
    <url-pattern>/surveillancecamera</url-pattern>
  </servlet-mapping>
  <!-- 202406 -->
  <servlet>
    <servlet-name>SurveillanceCameraProxyServlet</servlet-name>
    <servlet-class>com.google.gwt.personal.tupracticalpieces.server.SurveillanceCameraProxyServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MessageDigestServlet</servlet-name>
    <url-pattern>/messagedigest</url-pattern>
  </servlet-mapping>

