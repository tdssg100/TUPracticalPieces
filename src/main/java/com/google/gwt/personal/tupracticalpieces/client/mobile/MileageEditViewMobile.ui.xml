  <g:DockLayoutPanel
    ui:field="dockLayoutPanel"
    unit="PX">
    <!-- Edit Form. -->
    <g:center>


      <g:HTMLPanel
        ui:field="editForm"
        addStyleNames="{style.editForm}">



        <table
          cellspacing="10"
          align="center">

          <!-- Form title. -->
          <tr>
            <td
              align='center'
              colspan='2'
              class="{style.title}">Mileage Details</td>
          </tr>

          <!-- 
           * 20160511 editor
           -->
          <!-- Mileage supplyDate. -->
          <tr>
            <td
              class="{style.label}">Supply date:</td>
            <td>
              <app:DateButton
                addStyleNames="{style.field} {style.button} {style.dateButton}"
                ui:field="supplyDateEditor" />
            </td>
          </tr>

<!--           Mileage Quantity. -->
          <tr>
            <td
              class="{style.label}">Quantity:</td>
            <td class="{style.textBoxWrapper}">
              <app:DecimalBox
                addStyleNames="{style.field}"
                ui:field="quantityEditor" />
            </td>
          </tr>

<!--           Mileage unitPrice. -->
          <tr>
            <td
              class="{style.label}">UnitPrice:</td>
            <td class="{style.textBoxWrapper}">
              <g:IntegerBox
                addStyleNames="{style.field}"
                ui:field="unitPriceEditor" />
            </td>
          </tr>

<!--           Mileage TotalPrice. -->
          <tr>
            <td
              class="{style.label}">TotalPrice:</td>
            <td class="{style.textBoxWrapper}">
              <g:IntegerBox
                addStyleNames="{style.field}"
                ui:field="totalPriceEditor" />
            </td>
          </tr>

<!--           Mileage BsMileage. -->
          <tr>
            <td
              class="{style.label}">BsMileage:</td>
            <td class="{style.textBoxWrapper}">
              <app:DecimalBox
                addStyleNames="{style.field}"
                ui:field="bsMileageEditor" />
            </td>
          </tr>

<!--           Mileage TotalMileage. -->
          <tr>
            <td
              class="{style.label}">TotalMileage:</td>
            <td class="{style.textBoxWrapper}">
              <app:DecimalBox
                addStyleNames="{style.field}"
                ui:field="totalMileageEditor" />
            </td>
          </tr>

          <!-- Task name. SupplyDate	Quantity	UnitPrice	TotalPrice	BsMileage	TotalMileage-->
