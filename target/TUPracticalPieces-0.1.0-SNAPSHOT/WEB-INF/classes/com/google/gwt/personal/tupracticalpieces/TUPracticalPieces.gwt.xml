<module rename-to="tupracticalpieces">
  <!-- Inherit the core Web Toolkit stuff. -->
<!-- Inherit the default GWT style sheet. You can change       -->
<!-- the theme of your GWT application by uncommenting          -->
<!-- any one of the following lines.                           -->
<!-- <inherits name='com.google.gwt.user.theme.standard.Standard'/> -->
<inherits name="com.google.gwt.user.theme.chrome.Chrome"/>
<!--   <inherits name="com.google.gwt.user.theme.dark.Dark"/> -->
  <inherits name="com.google.gwt.canvas.Canvas"/>
  <inherits name="com.google.gwt.core.Core"/>
<!-- 20170526 for SimpleAppCacheLinker
  <inherits name="com.google.gwt.core.Ext"/>
-->
<!-- 
  <inherits name="com.google.gwt.user.User"/>
  <inherits name="com.google.gwt.http.HTTP"/>
 -->
  <!-- inherits name='com.google.gwt.xml.XML'/ -->
  <!-- inherits name='com.google.gwt.http.HTTP'/ -->
  <inherits name="com.google.gwt.i18n.I18N"/>
  <inherits name="com.google.gwt.i18n.CldrLocales"/>
  <!-- inherits name='com.google.api.gwt.oauth2.OAuth2'/ -->
  <!-- inherits name="com.google.appengine.api.users"/ -->
  <!-- Japanese language, independent of country -->
<!--   <inherits name="com.google.gwt.logging.Logging"/> -->
  
  <!-- Enable debug ID. -->
  <inherits name="com.google.gwt.user.Debug"/>
  <set-property name="gwt.enableDebugId" value="true"/> 

  <inherits name="com.google.gwt.resources.Resources"/>
  <!-- inherits name="com.google.gwt.user.theme.clean.CleanResources" /-->
  <!-- 20160123 for mobile -->
  <inherits name='com.google.gwt.activity.Activity'/>
  <inherits name='com.google.gwt.place.Place'/>
  <inherits name='com.google.gwt.user.User'/>
  <!-- 
  <inherits name="com.google.gwt.user.theme.standard.Standard" />
  <inherits name="javax.validation.Validation"/>
   -->
   
  <inherits name='com.google.gwt.editor.Editor'/>
  <inherits name='com.google.gwt.personal.tupracticalpieces.FormFactor'/>
  <inherits name='com.google.web.bindery.requestfactory.RequestFactory'/>
  <inherits name='com.google.gwt.json.JSON'/>
  <!-- for mobile
  <inherits name="com.github.gwtbootstrap.Bootstrap"/> 
   -->
  <!-- Use GWT's java.util.logging emulation -->
  <inherits name="com.google.gwt.logging.Logging"/>
<!--    <set-property name="gwt.logging.simpleRemoteHandler" value="ENABLED" /> -->
   <set-property name="gwt.logging.simpleRemoteHandler" value="DISABLED" />
   
    <set-property name="gwt.logging.logLevel" value="SEVERE"/>          # To change the  default logLevel
    <set-property name="gwt.logging.enabled" value="TRUE"/>            # To disable logging
    <set-property name="gwt.logging.consoleHandler" value="ENABLED"/>  # To disable a default Handler
   
   
   
  <inherits name='com.google.gwt.personal.gaerequest.GaeRequest'/>
  <inherits name='com.google.gwt.personal.ui.UI'/>

  <!-- for gwt-validation
      class="com.google.gwt.sample.validation.client.SampleValidatorFactory">
   -->
  <!-- 
  <inherits name="org.hibernate.validator.HibernateValidator" />
  <replace-with
      class="com.google.gwt.personal.tupracticalpieces.shared.SampleValidatorFactory">
      <when-type-is class="javax.validation.ValidatorFactory" />
  </replace-with>
   -->
   
   
   
  <!-- Specify the app entry point class. -->
  <entry-point class='com.google.gwt.personal.tupracticalpieces.client.TUPracticalPieces'/>


  <!-- Use ClientFactoryImpl by default -->
<!-- 
  <replace-with class="com.google.gwt.personal.tupracticalpieces.client.ClientFactoryImpl">
    <when-property-is name="formfactor" value="desktop"/>
    <when-property-is name="formfactor" value="tablet"/>
 -->
  <!-- Use a generator to create the source code -->
  <generate-with class="com.google.gwt.personal.tupracticalpieces.generator.TUPracticalPiecesGenerator">
    <when-type-assignable class="com.google.gwt.personal.tupracticalpieces.client.TUPracticalPieces.GeneratorInfo" />
  </generate-with>

  <replace-with class="com.google.gwt.personal.tupracticalpieces.client.ClientFactoryImpl">
    <when-type-is class="com.google.gwt.personal.tupracticalpieces.client.ClientFactory"/>
  </replace-with>

  <!-- Use ClientFactoryImplMobile for mobile form factor. -->
  <!-- 
   -->
  <replace-with class="com.google.gwt.personal.tupracticalpieces.client.ClientFactoryImplMobile">
    <when-type-is class="com.google.gwt.personal.tupracticalpieces.client.ClientFactory"/>
    <when-property-is name="formfactor" value="mobile"/>
  </replace-with>

  <!-- Use ClientFactoryImplTablet for tablet form factor. -->
  <!-- 
  <replace-with class="com.google.gwt.personal.tupracticalpieces.client.ClientFactoryImplTablet">
    <when-type-is class="com.google.gwt.personal.tupracticalpieces.client.ClientFactory"/>
    <when-property-is name="formfactor" value="tablet"/>
  </replace-with>
   -->
  <!-- 
  TODO appcache link folder
   -->
  <define-linker name="appcachelinker" class="com.google.gwt.personal.tupracticalpieces.linker.AppCacheLinker" />
  <add-linker name="appcachelinker" />

  <!-- Specify the paths for translatable code                    -->
  <source path='generator'/>
  <source path='ui'/>
  <source path='shared'/>
  <source path='presenter'/>
  <source path='client'/>


<!-- 
 -->

  <!-- SuperDevMode added at 20130615  -->
  <add-linker name="xsiframe"/>
  <set-configuration-property name="devModeRedirectEnabled" value="true"/>

  <!-- Internationalization support. -->
  <extend-property name="locale" values="en"/>
  <extend-property name="locale" values="ja"/>
  <set-property-fallback name="locale" value="en"/>
  <set-configuration-property name="locale.cookie" value="TUPRACTICALPIECES_LOCALE"/>
  <set-configuration-property name="locale.useragent" value="Y"/>
  <!--  For GSS converting way
  -->
  <!--  TODO suspendig For GSS 
  <set-configuration-property name="CssResource.enableGss" value="true" />
  <set-configuration-property name="CssResource.conversionMode" value="off" />
  -->
  <!-- Avoid permutation exploding
   -->
  <set-property name="compiler.useSourceMaps" value="true" />
  <set-property name="user.agent" value="safari, gecko1_8"/>
  <collapse-all-properties />
   
  <!-- Including External JavaScript. --> 
  <!-- <script src="fractal.js"/--> 
  <!-- <script src="glUtils.js"/--> 
  <!-- <script src="sylverster.js"/-->
  <!--  Enable the cross-site linking 20140506-->
  <!-- mgwt 20150616 
  <inherits name='com.googlecode.mgwt.MGWT'/>
  <inherits name="com.google.maps.gwt.GoogleMaps" />
  -->
  
</module>
